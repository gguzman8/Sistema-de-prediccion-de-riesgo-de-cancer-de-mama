# Puerto del servidor Node
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Origenes permitidos por CORS (separados por espacio) o "*"
CORS_ORIGIN=*

# Tamaño máximo de imagen en MB
MAX_FILE_SIZE_MB=8

# URL del servicio Python de IA (a integrar)
AI_SERVICE_URL=http://localhost:8000

# Timeout en milisegundos para llamadas al servicio de IA
AI_SERVICE_TIMEOUT_MS=60000

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info